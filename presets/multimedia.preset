# Multimedia Preset
# Usage: ./init.sh --preset presets/multimedia.preset
#
# This preset configures a multimedia workstation (video/audio/graphics)

# Profile selection
PROFILE="hyprland"

# Multimedia packages
EXTRA_PACKAGES="gimp vlc firefox"

# Standard partition layout
# LAYOUT="
# [swap] linux-swap auto
# / btrfs rest
# "

# Locale and timezone (will auto-detect if not specified)
# LOCALE="en_US.UTF-8"
# TIMEZONE="Europe/Lisbon"
